# Code owners for review routing: GitHub requests review from the owner on a
# pull request that changes these paths. Whether that review is required is a
# branch setting, not this file. No org team has access to this repo, so the
# owner is a named login.

# CI workflows: a change here can alter what runs with repo secrets.
/.github/workflows/          @nimrodbusany

# Dependency manifests and lockfiles.
/deps/                       @nimrodbusany

# Skill assets and requirements files (installed into user environments).
/skills/traigent-first-run/assets/   @nimrodbusany
**/requirements*.txt                 @nimrodbusany

# Maintenance tooling (relock, guard census, disclosure scan).
/tools/                      @nimrodbusany

# Security policy and the test that pins its reporting routes.
/SECURITY.md                         @nimrodbusany
/tests/test_security_policy.py       @nimrodbusany
