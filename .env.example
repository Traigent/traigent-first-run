# Reference only. The guided first run creates a minimal .env containing the selected provider.
# Copy to .env, keep it git-ignored, and leave every unused key absent rather than blank.

# Add only when the connected Traigent run is about to start.
# Portal API keys begin with uk_.
TRAIGENT_API_KEY=

# Choose ONE provider section. OpenRouter is a convenient default because one key reaches
# multiple model vendors. Prompts/examples sent to a model go to that provider as usual.
OPENROUTER_API_KEY=

# Alternatives - replace the OpenRouter line with exactly one of these when selected.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# COHERE_API_KEY=

# SDK limit for one optimization call, such as the baseline or bounded search. This does not cap
# evaluator/judge calls, retries/composites, holdout calls, or the walkthrough in aggregate.
# The assistant separately records and enforces the explicitly approved aggregate budget ledger.
TRAIGENT_RUN_COST_LIMIT=5.00

# Never persist TRAIGENT_COST_APPROVED here. The assistant sets it only in the explicitly
# approved process so later runs cannot silently bypass the approval prompt.
