# Traigent — secrets + run settings. COPY THIS FILE TO ".env" AND FILL THE BLANKS.
#   cp .env.example .env
# .env holds SECRETS and is filled ONCE. NEVER commit it (it is already in .gitignore).
# All keys stay on YOUR machine — Traigent's cloud never receives your provider keys,
# prompts, inputs, or outputs. Only configuration choices and numeric scores are synced.

# =============================================================================
# 1) Traigent platform key  (REQUIRED — this is NOT an LLM vendor key)
# =============================================================================
# Get it from https://portal.traigent.ai/register  ->  sign in  ->  API Keys
#   (top-right profile menu, or https://portal.traigent.ai/management/api-keys)
#   ->  + Create API Key  ->  choose "Full access".  Shown once; paste it exactly.
# Portal keys begin with  uk_  (46 chars)  or  tg_  (64 chars).
TRAIGENT_API_KEY=

# Backend the SDK talks to. The SDK already defaults to the cloud; setting this pins the
# production backend explicitly (avoids picking up stored CLI dev creds or an old env var
# that points at a local dev backend).
TRAIGENT_BACKEND_URL=https://portal.traigent.ai

# =============================================================================
# 2) One LLM vendor key  (REQUIRED — this is what actually runs the trials)
# =============================================================================
# RECOMMENDED: OpenRouter — one key reaches dozens of vendors (incl. low-cost and
# open-source models), and it meters real cost. Model id form (via LiteLLM):
#   openrouter/<vendor>/<model>     e.g. openrouter/openai/gpt-4o-mini
# Get a key: https://openrouter.ai/keys   •   Add credits: https://openrouter.ai/credits
# WARNING: FUND THE ACCOUNT (a few $). A free-tier OpenRouter key returns HTTP 402
# on paid models and silently fails most trials.
OPENROUTER_API_KEY=          # sk-or-v1-...

# --- OR use a direct provider key (any you already have) ---------------------
OPENAI_API_KEY=              # gpt-*            (validated before the run)
ANTHROPIC_API_KEY=           # claude-*         (validated before the run)
GEMINI_API_KEY=              # gemini-*  (or GOOGLE_API_KEY)  (validated)
MISTRAL_API_KEY=             # mistral-*        (validated before the run)
COHERE_API_KEY=              # command-*        (validated before the run)
# HuggingFace: set HF_TOKEN (the standard HF var). HF runs work, but the key is
# NOT pre-validated and HF model names need an explicit / litellm-prefixed id.
# HF_TOKEN=
# AWS Bedrock: AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY= / AWS_REGION= for bedrock/* models
#
# Tip: more model variety across vendors + price tiers = the single biggest cost
# lever Traigent has. One premium + a couple mid/low-cost models is a great start.

# =============================================================================
# 3) Run safety  (sensible defaults — adjust if you want)
# =============================================================================
# Hard cap on spend PER optimization run, in USD (SDK default is 2.00).
TRAIGENT_RUN_COST_LIMIT=5.00
# Real (paid) runs are gated. The guide does a free dry-run first, then asks you
# before any paid run. Setting this to "true" skips the interactive pre-run cost prompt
# (needed when an assistant runs Python non-interactively); the $5 runtime cap still applies.
# TRAIGENT_COST_APPROVED=true
